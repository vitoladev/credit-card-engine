{
  "$schema": "https://turborepo.dev/schema.json",
  "futureFlags": {
    "experimentalGoWorkspaces": true
  },
  "tasks": {
    "build": {},
    "test": {},
    "lint": {},
    "format": {
      "cache": false
    },
    "loadtest": {
      "cache": false,
      "passThroughEnv": [
        "BASE_URL",
        "LOADTEST_RATE",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "AWS_SESSION_TOKEN",
        "AWS_DEFAULT_REGION",
        "AWS_REGION"
      ]
    }
  }
}
