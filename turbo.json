{
  "$schema": "https://turborepo.dev/schema.json",
  "futureFlags": {
    "experimentalGoWorkspaces": true
  },
  "tasks": {
    "build": {},
    "test": {
      "passThroughEnv": ["AWS_ENDPOINT_URL", "AWS_TEST_ENDPOINT"]
    },
    "lint": {},
    "format": {
      "cache": false
    },
    "loadtest": {
      "cache": false,
      "passThroughEnv": [
        "BASE_URL",
        "LOADTEST_RATE",
        "LOADTEST_PATH",
        "LOADTEST_DURATION",
        "LOADTEST_BATCH_CUSTOMERS",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "AWS_SESSION_TOKEN",
        "AWS_DEFAULT_REGION",
        "AWS_REGION"
      ]
    }
  }
}
